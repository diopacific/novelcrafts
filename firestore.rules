rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
       allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null && request.auth.token.email_verified == true; }

    // Validation for BibleState
    function isValidBibleState(data) {
      return data.keys().hasAll(['story', 'world', 'system', 'character', 'villain', 'structure', 'ownerId', 'updatedAt'])
        && data.keys().size() == 8
        && data.story is string && data.story.size() <= 100000
        && data.world is string && data.world.size() <= 100000
        && data.system is string && data.system.size() <= 100000
        && data.character is string && data.character.size() <= 100000
        && data.villain is string && data.villain.size() <= 100000
        && data.structure is string && data.structure.size() <= 100000
        && data.ownerId is string && data.ownerId == request.auth.uid
        && (data.updatedAt == request.time || data.updatedAt is timestamp); // We'll just allow Timestamp for simplicity if written from client
    }

    // Validation for Episode
    function isValidEpisode(data) {
      return data.keys().hasAll(['id', 'number', 'direction', 'content', 'summary', 'ownerId', 'createdAt'])
        && data.keys().size() == 7
        && data.id is string && data.id.size() <= 128
        && data.number is number
        && data.direction is string && data.direction.size() <= 100000
        && data.content is string && data.content.size() <= 100000
        && data.summary is string && data.summary.size() <= 100000
        && data.ownerId is string && data.ownerId == request.auth.uid
        && (data.createdAt == request.time || data.createdAt is timestamp);
    }

    match /users/{userId}/bible/{bibleId} {
      allow read: if isSignedIn() && userId == request.auth.uid;
      allow create: if isSignedIn() && userId == request.auth.uid && isValidId(userId) && isValidId(bibleId) && isValidBibleState(incoming());
      allow update: if isSignedIn() && userId == request.auth.uid && isValidId(userId) && isValidId(bibleId) && isValidBibleState(incoming()) && incoming().ownerId == existing().ownerId;
      allow delete: if false; // Don't allow deletion of bible for now
    }

    match /users/{userId}/episodes/{episodeId} {
      allow read: if isSignedIn() && userId == request.auth.uid;
      allow create: if isSignedIn() && userId == request.auth.uid && isValidId(userId) && isValidId(episodeId) && isValidEpisode(incoming());
      allow update: if isSignedIn() && userId == request.auth.uid && isValidId(userId) && isValidId(episodeId) && isValidEpisode(incoming()) && incoming().ownerId == existing().ownerId;
      allow delete: if isSignedIn() && userId == request.auth.uid && isValidId(userId) && isValidId(episodeId);
    }
  }
}
